   "source": [
    "# Demonstration of Label Homogenization\n",
    "test_raw_labels = ['cap1', 'MOSFET', 'res', 'integrated_circuit', 'USB_Type_C', 'open_circuit', 'unknown_part_99']\n",
    "print(\"Raw Label -> Homogenized KiCad Label:\")\n",
    "print(\"-------------------------------------\")\n",
    "for raw in test_raw_labels:\n",
    "    print(f\"{raw:20s} -> {homogenizer.homogenize(raw)}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
